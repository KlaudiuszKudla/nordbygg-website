---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import DirectContactBanner from '../../components/conversion/DirectContactBanner.astro';

export async function getStaticPaths() {
  return siteConfig.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} | ${siteConfig.companyName}`} description={service.shortDesc}>
  <section class="section-padding service-detail-hero">
    <div class="container service-detail-grid">
      <div class="service-detail-copy">
        <span class="eyebrow">Tjeneste i Oslo og omegn</span>
        <h1 class="service-title">{service.title} i Oslo</h1>
        <p class="service-lead">{service.shortDesc}</p>

        {service.highlights && (
          <ul class="service-highlights-list">
            {service.highlights.map((h) => (
              <li>✓ {h}</li>
            ))}
          </ul>
        )}

        <div class="service-meta-box">
          <div class="meta-item">
            <span class="meta-label">Typisk tidsramme:</span>
            <strong>{service.typicalTimeline}</strong>
          </div>
          <div class="meta-item">
            <span class="meta-label">Befaring:</span>
            <strong>Alltid gratis og uforpliktende</strong>
          </div>
        </div>
      </div>

      {service.image && (
        <div class="service-detail-media">
          <div class="service-media-card">
            <img src={service.image} alt={service.title} class="service-hero-img" width="600" height="420" />
          </div>
        </div>
      )}
    </div>
  </section>

  {service.scopeOfWork && (
    <section class="section-padding scope-section">
      <div class="container">
        <h2 class="section-subtitle">Hva inngår i arbeidet?</h2>
        <ul class="scope-grid">
          {service.scopeOfWork.map((step) => (
            <li class="scope-item">
              <span class="scope-icon">✓</span>
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <DirectContactBanner
    heading={`Ønsker du tilbud på ${service.title.toLowerCase()}?`}
    subheading={`Kontakt Waldemar Kudla for en uforpliktende prat og gratis befaring hjemme hos deg i Oslo.`}
    serviceName={service.title}
  />
</BaseLayout>

<style>
  .service-detail-hero {
    background-color: var(--bg-canvas);
    border-bottom: 1px solid var(--border-subtle);
  }
  .service-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .service-detail-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 3.5rem;
    }
  }
  .service-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin-bottom: 1.25rem;
  }
  .service-lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .service-highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-weight: 600;
    color: var(--accent-trust);
    margin-bottom: 2rem;
  }
  .service-meta-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .meta-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .service-media-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-subtle);
  }
  .service-hero-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  .scope-section {
    background-color: var(--bg-surface);
  }
  .section-subtitle {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 2rem;
  }
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .scope-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  .scope-item {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-weight: 500;
  }
  .scope-icon {
    color: var(--accent-trust);
    font-weight: 800;
  }
</style>
