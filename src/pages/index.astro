---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/sections/HeroHome.astro';
import ValuePillarsGrid from '../components/sections/ValuePillarsGrid.astro';
import AboutPartnerSection from '../components/sections/AboutPartnerSection.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import TestimonialGrid from '../components/sections/TestimonialGrid.astro';
import DirectContactBanner from '../components/conversion/DirectContactBanner.astro';
import { siteConfig } from '../data/siteConfig';

const pageTitle = `${siteConfig.companyName} | Vaktmester, drift og oppussing i Oslo`;
const pageDescription = `Eiendomsdrift, vaktmestertjenester og håndverk i Oslo med over ${siteConfig.experienceYears} års erfaring. Teknisk vedlikehold for borettslag/sameier, bad, kjøkken, gulv og maling.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <HeroHome />
  <ValuePillarsGrid />
  <AboutPartnerSection />
  <ServiceGrid />
  <FeaturedProjects />
  <TestimonialGrid />
  <DirectContactBanner />
</BaseLayout>
