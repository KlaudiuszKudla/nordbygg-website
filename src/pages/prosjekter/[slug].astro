---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import { projectsData } from '../../data/projects';
import { path } from '../../utils/paths';
import { buildSmartMailto } from '../../utils/mailtoBuilder';
import DirectContactBanner from '../../components/conversion/DirectContactBanner.astro';

export async function getStaticPaths() {
  return projectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Find matching services in siteConfig to cross-link
const matchedServices = siteConfig.services.filter((s) =>
  project.serviceSlugs.includes(s.slug)
);

// Other projects to explore
const otherProjects = projectsData.filter((p) => p.slug !== project.slug).slice(0, 3);

// Smart Mailto configured for this specific case study
const mailtoHref = buildSmartMailto({
  serviceName: `${project.title} (${project.neighborhood})`,
});
---

<BaseLayout
  title={`${project.title} | ${siteConfig.companyName}`}
  description={`${project.excerpt} Utført av ${siteConfig.companyName} (${project.neighborhood}).`}
>
  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb-nav" aria-label="Brødsmulesti">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href={path('/')}>Hjem</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li><a href={path('/prosjekter/')}>Prosjekter</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li aria-current="page">{project.title}</li>
      </ol>
    </div>
  </nav>

  <!-- Project Header & Hero -->
  <section class="project-hero section-padding">
    <div class="container">
      <div class="project-header-copy">
        <div class="project-badge-row">
          <span class="eyebrow">📍 {project.neighborhood}</span>
          <span class="ref-badge">Referanseprosjekt</span>
        </div>

        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.excerpt}</p>

        <div class="project-quick-meta">
          <div class="meta-item">
            <span class="meta-label">Eiendomstype</span>
            <strong class="meta-val">{project.buildingType}</strong>
          </div>
          <div class="meta-item">
            <span class="meta-label">Område</span>
            <strong class="meta-val">{project.neighborhood}</strong>
          </div>
          <div class="meta-item">
            <span class="meta-label">Utført av</span>
            <strong class="meta-val">{siteConfig.owner} ({siteConfig.companyName})</strong>
          </div>
          <div class="meta-item">
            <span class="meta-label">Befaring</span>
            <strong class="meta-val">Alltid gratis og uforpliktende</strong>
          </div>
        </div>

        <div class="project-actions">
          <a href={`tel:${siteConfig.phoneHref}`} class="btn-primary tabular-nums">
            📞 Ring {siteConfig.owner}: {siteConfig.phoneDisplay}
          </a>
          <a href={mailtoHref} class="btn-secondary">
            ✉️ Be om tilsvarende prosjekt
          </a>
        </div>
      </div>

      <!-- Featured Image Showcase -->
      <div class="project-visual-card">
        <img
          src={project.mainImage}
          alt={project.title}
          width="1200"
          height="650"
          class="project-hero-image"
          loading="eager"
        />
        <div class="visual-tag">
          <span class="tag-dot" aria-hidden="true"></span>
          <span>Ferdigstilt håndverk – {project.neighborhood}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Story: Challenge, Solution, Scope -->
  <section class="section-padding project-story-section">
    <div class="container story-grid">
      <!-- Main Content Column -->
      <div class="story-main">
        <!-- Challenge Box -->
        <article class="narrative-card challenge-box">
          <div class="narrative-header">
            <span class="narrative-icon" aria-hidden="true">🔍</span>
            <div>
              <span class="eyebrow text-accent">Før oppstart</span>
              <h2 class="narrative-title">Utgangspunkt og utfordring</h2>
            </div>
          </div>
          <p class="narrative-body">{project.challenge}</p>
        </article>

        <!-- Solution Box -->
        <article class="narrative-card solution-box">
          <div class="narrative-header">
            <span class="narrative-icon" aria-hidden="true">🛠️</span>
            <div>
              <span class="eyebrow text-trust">Håndverksløsning</span>
              <h2 class="narrative-title">Slik løste vi oppgaven</h2>
            </div>
          </div>
          <p class="narrative-body">{project.solution}</p>
        </article>

        <!-- Scope Checklist -->
        <section class="scope-checklist-section" aria-labelledby="scope-heading">
          <h2 id="scope-heading" class="section-subtitle">Hva ble utført i prosjektet:</h2>
          <ul class="scope-list">
            {project.scopeList.map((item) => (
              <li class="scope-item">
                <span class="check-icon" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Project Photo Story / Gallery -->
        {project.gallery && project.gallery.length > 0 && (
          <section class="project-gallery-section" aria-labelledby="gallery-heading">
            <div class="gallery-header">
              <span class="eyebrow text-trust">Fotodokumentasjon</span>
              <h2 id="gallery-heading" class="section-subtitle">Bilder fra prosjektet og utførelsen</h2>
              <p class="gallery-lead">Se detaljer fra bygningen, arbeidet underveis og det ferdige resultatet:</p>
            </div>

            <div class="gallery-grid">
              {project.gallery.map((img) => (
                <figure class="gallery-item">
                  <div class="gallery-image-wrapper">
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      width="700"
                      height="460"
                      class="gallery-img"
                    />
                    {img.phase && (
                      <span class={`phase-badge phase-${img.phase.toLowerCase().replace(/\s+/g, '-')}`}>
                        {img.phase}
                      </span>
                    )}
                  </div>
                  {img.caption && (
                    <figcaption class="gallery-caption">
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </section>
        )}

        <!-- Client Quote / Review -->
        {project.clientQuote && (
          <aside class="client-quote-card" aria-label="Kundeomtale">
            <div class="quote-stars" aria-hidden="true">★★★★★</div>
            <blockquote class="client-quote-text">
              «{project.clientQuote.quote}»
            </blockquote>
            <div class="client-quote-meta">
              <strong>{project.clientQuote.author}</strong> – {project.clientQuote.neighborhood}
            </div>
          </aside>
        )}
      </div>

      <!-- Sticky Sidebar -->
      <aside class="story-sidebar">
        <!-- Project Facts Card -->
        <div class="sidebar-card">
          <h3 class="sidebar-title">Prosjektfakta</h3>
          <ul class="facts-list">
            <li>
              <span class="fact-label">Sted:</span>
              <span class="fact-val">{project.neighborhood}</span>
            </li>
            <li>
              <span class="fact-label">Bygning:</span>
              <span class="fact-val">{project.buildingType}</span>
            </li>
            <li>
              <span class="fact-label">Utførelse:</span>
              <span class="fact-val">Direkte av {siteConfig.owner}</span>
            </li>
            <li>
              <span class="fact-label">Prisavtale:</span>
              <span class="fact-val">Tydelig skriftlig tilbud</span>
            </li>
            <li>
              <span class="fact-label">Befaring:</span>
              <span class="fact-val">Alltid gratis</span>
            </li>
          </ul>
        </div>

        <!-- Materials Used Card -->
        {project.materialsUsed && project.materialsUsed.length > 0 && (
          <div class="sidebar-card">
            <h3 class="sidebar-title">Materialer og leverandører</h3>
            <ul class="materials-list">
              {project.materialsUsed.map((mat) => (
                <li>
                  <span class="bullet" aria-hidden="true">●</span>
                  <span>{mat}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Related Services Card -->
        {matchedServices.length > 0 && (
          <div class="sidebar-card related-services-card">
            <h3 class="sidebar-title">Relevante tjenester</h3>
            <p class="sidebar-desc">
              Ønsker du mer informasjon om hvordan vi utfører dette fagfeltet?
            </p>
            <div class="sidebar-links-group">
              {matchedServices.map((service) => (
                <a href={service.href} class="service-pill-link">
                  <span>{service.title}</span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Quick Contact Sidebar Card -->
        <div class="sidebar-card contact-help-card">
          <h3 class="sidebar-title">Planlegger du noe lignende?</h3>
          <p class="sidebar-desc">
            Ta en uforpliktende telefon til {siteConfig.owner} for å drøfte mulighetene i din bolig.
          </p>
          <a href={`tel:${siteConfig.phoneHref}`} class="btn-sidebar-phone tabular-nums">
            📞 {siteConfig.phoneDisplay}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- More Projects Teaser -->
  {otherProjects.length > 0 && (
    <section class="section-padding more-projects-section" aria-labelledby="other-projects-heading">
      <div class="container">
        <div class="more-projects-header">
          <div>
            <span class="eyebrow">Flere referanser</span>
            <h2 id="other-projects-heading" class="section-title">Andre prosjekter i Oslo</h2>
          </div>
          <a href={path('/prosjekter/')} class="view-all-link">Se alle prosjekter →</a>
        </div>

        <div class="more-projects-grid">
          {otherProjects.map((item) => (
            <article class="related-project-card">
              <a href={item.href} class="card-img-wrap" tabindex="-1" aria-hidden="true">
                <img src={item.mainImage} alt={item.title} loading="lazy" width="400" height="230" />
                <span class="related-loc-badge">📍 {item.neighborhood}</span>
              </a>
              <div class="card-body">
                <h3 class="card-title">
                  <a href={item.href}>{item.title}</a>
                </h3>
                <p class="card-excerpt">{item.excerpt}</p>
                <a href={item.href} class="card-link">Les om prosjektet →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Direct Contact Banner -->
  <DirectContactBanner
    heading={`Ønsker du et lignende resultat i ditt hjem?`}
    subheading={`Vi utfører kvalitetsarbeid i ${project.neighborhood} og hele Oslo-området. Ta kontakt med ${siteConfig.owner} for gratis befaring.`}
    serviceName={project.title}
  />
</BaseLayout>

<style>
  /* Breadcrumbs */
  .breadcrumb-nav {
    background-color: var(--bg-canvas);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem 0;
    font-size: 0.875rem;
  }
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }
  .breadcrumb-list a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .breadcrumb-list a:hover {
    color: var(--accent-primary);
  }
  .breadcrumb-list [aria-current="page"] {
    color: var(--text-main);
    font-weight: 600;
  }
  .separator {
    color: var(--border-subtle);
  }

  /* Project Hero */
  .project-hero {
    background-color: var(--bg-canvas);
    border-bottom: 1px solid var(--border-subtle);
  }
  .project-header-copy {
    max-width: 82ch;
    margin-bottom: 2.5rem;
  }
  .project-badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .ref-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-surface);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
  .project-title {
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .project-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .project-quick-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .project-quick-meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .meta-val {
    font-size: 0.9375rem;
    color: var(--text-main);
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-primary {
    background-color: var(--accent-primary);
    color: #ffffff;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s ease;
  }
  .btn-primary:hover {
    background-color: var(--accent-primary-hover);
  }
  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-main);
    border: 1px solid var(--border-subtle);
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-secondary:hover {
    background-color: #ffffff;
    border-color: var(--text-muted);
  }

  /* Visual Showcase Card */
  .project-visual-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-subtle);
    margin-top: 2rem;
  }
  .project-hero-image {
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    display: block;
  }
  .visual-tag {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    background-color: rgba(24, 43, 54, 0.9);
    backdrop-filter: blur(8px);
    color: #ffffff;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tag-dot {
    width: 8px;
    height: 8px;
    background-color: #4ade80;
    border-radius: 50%;
  }

  /* Story Layout */
  .project-story-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  /* Narrative Cards */
  .narrative-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .challenge-box {
    border-left: 5px solid var(--accent-primary);
  }
  .solution-box {
    border-left: 5px solid var(--accent-trust);
  }
  .narrative-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .narrative-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .text-accent {
    color: var(--accent-primary);
  }
  .text-trust {
    color: var(--accent-trust);
  }
  .narrative-title {
    font-size: 1.35rem;
    margin-top: 0.25rem;
  }
  .narrative-body {
    font-size: 1.0625rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0;
  }

  /* Scope Checklist */
  .scope-checklist-section {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .section-subtitle {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .scope-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .scope-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-main);
  }
  .check-icon {
    flex-shrink: 0;
    color: var(--accent-trust);
    font-weight: 800;
  }

  /* Client Quote */
  .client-quote-card {
    background-color: var(--accent-trust-bg);
    border: 1px solid #c2ded1;
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }

  /* Photo Story / Gallery */
  .project-gallery-section {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .gallery-header {
    margin-bottom: 1.5rem;
  }
  .gallery-lead {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .gallery-item {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--bg-surface);
  }
  .gallery-image-wrapper {
    position: relative;
    width: 100%;
    height: 240px;
    background-color: #121212;
    overflow: hidden;
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }
  .gallery-item:hover .gallery-img {
    transform: scale(1.03);
  }
  .phase-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .phase-bygningen {
    background-color: rgba(24, 43, 54, 0.9);
    color: #ffffff;
  }
  .phase-under-arbeid {
    background-color: rgba(196, 85, 45, 0.92);
    color: #ffffff;
  }
  .phase-ferdigstilt {
    background-color: rgba(42, 92, 67, 0.92);
    color: #ffffff;
  }
  .phase-detalj {
    background-color: rgba(33, 57, 71, 0.9);
    color: #ffffff;
  }
  .gallery-caption {
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    color: var(--text-main);
    line-height: 1.5;
    background-color: var(--bg-card);
    border-top: 1px solid var(--border-subtle);
  }
  .quote-stars {
    color: #eab308;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  .client-quote-text {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .client-quote-meta {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  /* Sticky Sidebar */
  .story-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 960px) {
    .story-sidebar {
      position: sticky;
      top: 2rem;
      align-self: flex-start;
    }
  }
  .sidebar-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .sidebar-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.65rem;
  }
  .sidebar-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .facts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .facts-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    gap: 0.5rem;
  }
  .fact-label {
    color: var(--text-muted);
  }
  .fact-val {
    font-weight: 600;
    color: var(--text-main);
    text-align: right;
  }
  .materials-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .materials-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-main);
  }
  .bullet {
    color: var(--accent-primary);
    font-size: 0.625rem;
    margin-top: 0.35rem;
  }
  .sidebar-links-group {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .service-pill-link {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .service-pill-link:hover {
    background-color: #ffffff;
    border-color: var(--accent-primary);
    color: var(--accent-primary);
