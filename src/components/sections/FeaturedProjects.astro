---
import { projectsData } from '../../data/projects';
import { path } from '../../utils/paths';

// Feature the top 4 projects from the central projects dataset (2x2 balanced grid)
const featuredProjects = projectsData.slice(0, 4);
---

<section class="projects-section section-padding">
  <div class="container">
    <div class="projects-header">
      <div>
        <span class="eyebrow">Utført arbeid i Oslo</span>
        <h2 class="section-title">Nylige prosjekter</h2>
      </div>
      <a href={path('/prosjekter/')} class="view-all-link">Se alle referanser →</a>
    </div>

    <div class="projects-grid">
      {featuredProjects.map((project) => (
        <article class="project-card">
          <div class="project-image">
            <a href={project.href} tabindex="-1" aria-hidden="true">
              <img src={project.mainImage} alt={project.title} loading="lazy" width="500" height="280" />
            </a>
            {project.gallery && project.gallery.length > 1 && (
              <span class="gallery-count-badge">📷 {project.gallery.length} bilder</span>
            )}
          </div>
          <div class="project-content">
            <div class="project-meta-top">
              <span>📍 {project.neighborhood}</span>
            </div>
            <h3 class="project-title">
              <a href={project.href}>{project.title}</a>
            </h3>
            <p class="project-building">{project.buildingType}</p>
            <p class="project-summary">{project.excerpt}</p>
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }
  .projects-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }
  .section-title {
    font-size: 2rem;
  }
  .view-all-link {
    font-weight: 700;
    color: var(--accent-primary);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .project-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .project-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background-color: var(--bg-surface);
  }
  .gallery-count-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: rgba(24, 43, 54, 0.88);
    color: #ffffff;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .project-image a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-image img {
    transform: scale(1.04);
  }
  .project-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .project-meta-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-trust);
    margin-bottom: 0.75rem;
  }
  .project-title {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }
  .project-title a:hover {
    color: var(--accent-primary);
  }
  .project-building {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }
</style>
