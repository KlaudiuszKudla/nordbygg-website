---
import { siteConfig } from '../../data/siteConfig';
import { path } from '../../utils/paths';
---

<section class="partner-section section-padding" aria-labelledby="partner-heading">
  <div class="container partner-grid">
    <div class="partner-copy">
      <span class="eyebrow">Helhetlig oppussing i Oslo</span>
      <h2 id="partner-heading" class="section-title">
        En personlig håndverker med bred erfaring
      </h2>
      <p>
        Når du skal pusse opp leilighet eller enebolig i Oslo, slipper du å koordinere fem ulike
        firmaer. Med {siteConfig.experienceYears} års praktisk erfaring tar {siteConfig.owner} ansvar for helheten.
      </p>
      <p>
        Våre <strong>lokale samarbeidspartnere</strong> på rør og elektro sørger for at alt arbeid utføres av fagfolk.
      </p>
      <a href={path('/om-oss/')} class="link-arrow">Les mer om {siteConfig.owner} →</a>
    </div>

    <div class="scope-overview-box">
      <h3 class="scope-box-title">Vi utfører blant annet:</h3>
      <ul class="scope-checklist">
        <li>Vaktmestertjenester & teknisk eiendomsdrift</li>
        <li>Løpende vedlikehold for borettslag & sameier</li>
        <li>Totaloppussing av bad og våtrom</li>
        <li>Kjøkkenmontering</li>
        <li>Avretting av skjeve gulv & parkettlegging</li>
        <li>Innvendig malerarbeid & helsparkling</li>
        <li>Utvendig maling av trehus og fasader</li>
        <li>Snekkerarbeid og innredninger</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .partner-section {
    border-bottom: 1px solid var(--border-subtle);
  }
  .partner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .partner-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }
  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    margin-bottom: 1.25rem;
  }
  .link-arrow {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--accent-primary);
  }
  .link-arrow:hover {
    text-decoration: underline;
  }
  .scope-overview-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  .scope-box-title {
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .scope-checklist {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .scope-checklist li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .scope-checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent-trust);
    font-weight: 800;
  }
</style>
