---
const testimonials = [
  {
    quote: 'Waldemar hjalp oss med totaloppussing av kjøkken og gulvlegging. Punktlig, veldig ryddig og nydelig finish!',
    author: 'Marte & Henrik L.',
    context: 'St. Hanshaugen, Oslo',
  },
  {
    quote: 'Utrolig behagelig å forholde seg til én fast håndverker på baderomsoppussingen. Anbefales!',
    author: 'Anders K.',
    context: 'Frogner, Oslo',
  },
];
---

<section class="testimonials-section section-padding">
  <div class="container">
    <div class="reviews-header">
      <div>
        <span class="eyebrow">Tilbakemeldinger</span>
        <h2 class="section-title">Hva sier kundene våre?</h2>
      </div>
      <div class="rating-pill"><span>★★★★★</span> <strong>5,0 / 5 i snitt</strong></div>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((item) => (
        <blockquote class="testimonial-card">
          <div class="stars">★★★★★</div>
          <p class="testimonial-quote">«{item.quote}»</p>
          <footer>
            <strong>{item.author}</strong><br/>
            <span>{item.context}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }
  .section-title {
    font-size: 2rem;
  }
  .rating-pill {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
  }
  .stars {
    color: #D97706;
    margin-bottom: 0.75rem;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .testimonial-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }
  .testimonial-quote {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }
</style>
