---
import { siteConfig } from '../../data/siteConfig';
import { path } from '../../utils/paths';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand / Logo -->
    <a href={path('/')} class="brand-logo" aria-label={`${siteConfig.companyName} - Til forsiden`}>
      <span class="logo-mark" aria-hidden="true">{siteConfig.companyName.charAt(0)}</span>
      <div class="logo-text">
        <span class="logo-name">{siteConfig.companyName}</span>
        <span class="logo-sub">Oppussing & Håndverk i Oslo</span>
      </div>
    </a>

    <!-- Desktop Navigation (Hidden on < 900px) -->
    <nav class="desktop-nav" aria-label="Hovedmeny for datamaskin">
      <ul class="nav-list">
        <li><a href={path('/')} class="nav-link">Hjem</a></li>
        <li class="nav-dropdown-wrapper">
          <details class="nav-details" id="desktop-services-details">
            <summary class="nav-link nav-summary">
              <span>Tjenester</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </summary>
            <ul class="dropdown-menu">
              {siteConfig.services.map((service) => (
                <li>
                  <a href={service.href} class="dropdown-link">{service.title}</a>
                </li>
              ))}
              <li class="dropdown-divider">
                <a href={path('/tjenester/')} class="dropdown-link dropdown-all">Se alle tjenester →</a>
              </li>
            </ul>
          </details>
        </li>
        <li><a href={path('/prosjekter/')} class="nav-link">Prosjekter</a></li>
        <li><a href={path('/om-oss/')} class="nav-link">Om oss</a></li>
        <li><a href={path('/kontakt/')} class="nav-link">Kontakt</a></li>
      </ul>
    </nav>

    <!-- Desktop Direct CTA -->
    <div class="header-cta">
      <a href={`tel:${siteConfig.phoneHref}`} class="header-phone-btn tabular-nums">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{siteConfig.phoneDisplay}</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button (< 900px) -->
    <button
      type="button"
      id="mobile-nav-toggle"
      class="mobile-menu-btn"
      aria-label="Åpne navigasjonsmeny"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <svg class="hamburger-svg hamburger-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg class="hamburger-svg hamburger-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span class="menu-label" id="mobile-btn-label">Meny</span>
    </button>
  </div>

  <!-- Full-Screen Mobile Drawer (< 900px) -->
  <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <nav class="mobile-nav" aria-label="Mobil navigasjon">
        <ul class="mobile-nav-list">
          <li>
            <a href={path('/')} class="mobile-nav-link">
              <span>Hjem</span>
              <span class="nav-chevron" aria-hidden="true">→</span>
            </a>
          </li>

          <!-- Mobile Services Accordion -->
          <li class="mobile-nav-group">
            <details class="mobile-services-accordion" open>
              <summary class="mobile-nav-link mobile-services-summary">
                <div class="services-title-wrap">
                  <span>Tjenester</span>
                  <span class="services-count-badge">6 fagområder</span>
                </div>
                <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </summary>
              <ul class="mobile-subnav-list">
                {siteConfig.services.map((service) => (
                  <li>
                    <a href={service.href} class="mobile-subnav-link">
                      <span class="subnav-dot" aria-hidden="true"></span>
                      <span>{service.title}</span>
                    </a>
                  </li>
                ))}
                <li class="mobile-subnav-all-wrap">
                  <a href={path('/tjenester/')} class="mobile-subnav-all">
                    <span>Oversikt over alle tjenester</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              </ul>
            </details>
          </li>

          <li>
            <a href={path('/prosjekter/')} class="mobile-nav-link">
              <span>Prosjekter & Referanser</span>
              <span class="nav-chevron" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href={path('/om-oss/')} class="mobile-nav-link">
              <span>Om oss & Waldemar</span>
              <span class="nav-chevron" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a href={path('/kontakt/')} class="mobile-nav-link">
              <span>Kontakt</span>
              <span class="nav-chevron" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Drawer Bottom Direct CTA & Trust Pills -->
      <div class="mobile-drawer-bottom">
        <a href={`tel:${siteConfig.phoneHref}`} class="mobile-drawer-phone-card">
          <div class="drawer-phone-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="drawer-phone-text">
            <span class="phone-label">Ring Waldemar direkte</span>
            <span class="phone-number tabular-nums">{siteConfig.phoneDisplay}</span>
          </div>
        </a>

        <div class="mobile-drawer-trust">
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span>0 kr forskudd</span>
          </div>
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span>Avtalt fastpris</span>
          </div>
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span>15+ år i Oslo</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(250, 248, 245, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    gap: 1.25rem;
  }

  /* Brand / Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    z-index: 102;
  }
  .logo-mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  .logo-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--text-main);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .logo-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .logo-sub {
      display: none;
    }
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }
  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
      align-items: center;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-main);
    padding: 0.4rem 0.25rem;
    cursor: pointer;
    transition: color 0.15s ease;
    text-decoration: none;
    background: transparent;
    border: none;
  }
  .nav-link:hover {
    color: var(--accent-primary);
  }

  /* Desktop Dropdown */
  .nav-dropdown-wrapper {
    position: relative;
  }
  .nav-details {
    position: relative;
  }
  .nav-summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    user-select: none;
    outline: none;
  }
  .nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-summary::marker {
    display: none;
    content: "";
  }
  .nav-summary svg {
    transition: transform 0.2s ease;
  }
  .nav-details[open] .nav-summary svg {
    transform: rotate(180deg);
  }
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    min-width: 270px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 36px rgba(24, 43, 54, 0.16);
    padding: 0.5rem;
    z-index: 110;
    list-style: none;
    margin: 0;
  }
  .dropdown-link {
    display: block;
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .dropdown-link:hover {
    background-color: var(--bg-surface);
    color: var(--accent-primary);
  }
  .dropdown-divider {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--border-subtle);
  }
  .dropdown-all {
    font-weight: 700;
    color: var(--accent-primary);
  }

  /* Desktop Phone CTA */
  .header-cta {
    display: none;
    flex-shrink: 0;
  }
  @media (min-width: 900px) {
    .header-cta {
      display: block;
    }
  }
  .header-phone-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .header-phone-btn:hover {
    background-color: var(--accent-primary);
  }

  /* Mobile Hamburger Toggle Button */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    z-index: 102;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .mobile-menu-btn:hover,
  .mobile-menu-btn:focus-visible {
    background-color: var(--border-subtle);
  }
  @media (min-width: 900px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* SVG Icons for Hamburger */
  .hamburger-svg {
    display: block;
    flex-shrink: 0;
  }
  .hamburger-icon-close {
    display: none;
  }
  .mobile-menu-btn.is-active .hamburger-icon-open {
    display: none;
  }
  .mobile-menu-btn.is-active .hamburger-icon-close {
    display: block;
    color: var(--accent-primary);
  }

  /* Full-Screen Mobile Drawer (< 900px) */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 4.5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #FAF8F5; /* var(--bg-canvas) */
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    z-index: 101;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-drawer.is-open {
    display: block;
    animation: drawerFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes drawerFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 900px) {
    .mobile-drawer {
      display: none !important;
    }
  }

  .mobile-drawer-inner {
    padding: 1.25rem 1.25rem 5rem;
    max-width: 560px;
    margin: 0 auto;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-main);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background-color: var(--bg-surface);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .nav-chevron {
    color: var(--text-muted);
    font-weight: 400;
  }

  /* Services Accordion inside drawer */
  .mobile-services-accordion {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .mobile-services-summary {
    list-style: none;
    cursor: pointer;
    background-color: transparent;
    border: none;
    border-radius: 0;
    margin: 0;
    user-select: none;
  }
  .mobile-services-summary::-webkit-details-marker {
    display: none;
  }
  .mobile-services-summary::marker {
    display: none;
    content: "";
  }
  .services-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .services-count-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    letter-spacing: normal;
  }
  .accordion-chevron {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .mobile-services-accordion[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .mobile-subnav-list {
    list-style: none;
    padding: 0 0 0.5rem 0;
    margin: 0;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }
  .mobile-subnav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.65rem 1.25rem;
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .mobile-subnav-link:hover,
  .mobile-subnav-link:active {
    background-color: rgba(196, 85, 45, 0.08);
    color: var(--accent-primary);
  }
  .subnav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-primary);
    flex-shrink: 0;
  }
  .mobile-subnav-all-wrap {
    padding: 0.5rem 1.25rem 0.25rem;
  }
  .mobile-subnav-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-primary);
    text-decoration: none;
    padding: 0.5rem 0;
  }

  /* Drawer Bottom Phone Card & Trust Signals */
  .mobile-drawer-bottom {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-drawer-phone-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(24, 43, 54, 0.12);
    transition: background-color 0.15s ease;
  }
  .mobile-drawer-phone-card:hover,
  .mobile-drawer-phone-card:active {
    background-color: var(--accent-primary);
  }
  .drawer-phone-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }
  .drawer-phone-text {
    display: flex;
    flex-direction: column;
  }
  .phone-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .phone-number {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-on-dark);
    letter-spacing: 0.01em;
  }

  .mobile-drawer-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .trust-pill svg {
    color: var(--accent-primary);
  }
</style>

<script>
  function setupHeaderNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const btnLabel = document.getElementById('mobile-btn-label');
    const desktopDetails = document.getElementById('desktop-services-details') as HTMLDetailsElement | null;

    if (!toggleBtn || !drawer) return;

    function openMenu() {
      toggleBtn.classList.add('is-active');
      toggleBtn.setAttribute('aria-expanded', 'true');
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      if (btnLabel) btnLabel.textContent = 'Lukk';
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      toggleBtn.classList.remove('is-active');
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      if (btnLabel) btnLabel.textContent = 'Meny';
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      const isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Toggle mobile drawer
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Close mobile drawer when clicking navigation links inside drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close mobile menu on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (drawer.classList.contains('is-open')) {
          closeMenu();
          toggleBtn.focus();
        }
        if (desktopDetails && desktopDetails.open) {
          desktopDetails.open = false;
        }
      }
    });

    // Close mobile menu if resized to desktop viewport >= 900px
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900 && drawer.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Close desktop details dropdown if clicked outside
    document.addEventListener('click', (e) => {
      if (desktopDetails && desktopDetails.open) {
        if (!desktopDetails.contains(e.target as Node)) {
          desktopDetails.open = false;
        }
      }
    });
  }

  // Run on first load and on astro page navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderNav);
  } else {
    setupHeaderNav();
  }
  document.addEventListener('astro:page-load', setupHeaderNav);
</script>
